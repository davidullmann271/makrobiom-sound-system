# Ableton-generated sample analysis — rebuilt automatically, pure noise in diffs
*.asd

# Windows shell cruft
Desktop.ini
Thumbs.db
.DS_Store

# Recorded audio — deliberately not in the repo (132 MB on the first pass).
# Remove this rule if you ever need the samples versioned alongside the set.
# Exception: the drums set's dummy-clip sample is force-added and therefore
# tracked. If you ever delete and re-add it, use `git add -f` or it will be
# ignored again.
# Live's own backup sets stay local too (automatic snapshots, not history).
projects/*/Samples/
projects/*/Backup/

# Demo recordings, kept local
demos/
